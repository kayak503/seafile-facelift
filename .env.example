# Published image. Pin a version tag or digest in production.
SEAFILE_FACELIFT_IMAGE=ghcr.io/kayak503/seafile-facelift:latest

# Host port used by the existing Caddy reverse proxy.
SEAFILE_FACELIFT_PORT=8082

# Internal Seafile URL used only by the backend. Use the reachable local IP and port;
# Seafile-Facelift does not need to join Seafile's Docker network.
SEAFILE_URL=http://192.168.1.115:8081

# Public origins used for links, redirects, and same-origin validation.
PUBLIC_SEAFILE_URL=https://seafile.grapple.link
APP_URL=https://drive.grapple.link

# Required random text (not JSON): replace this entire value with `openssl rand -hex 32` output.
SESSION_SECRET=REPLACE_WITH_GENERATED_OUTPUT

# Optional branding and administration destination.
APP_NAME=Seafile-Facelift
APP_ACCENT=#2563EB
ADMIN_URL=https://seafile.grapple.link/profile/
