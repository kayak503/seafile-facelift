# Published image. Pin a version tag or digest in production.
GRAPPLE_IMAGE=ghcr.io/kayak503/seafile-facelift:latest

# Host port and the existing Docker network shared with Seafile.
GRAPPLE_PORT=8082
SEAFILE_NETWORK=seafile

# Private Seafile URL used for server-to-server API calls.
SEAFILE_URL=http://seafile

# Public origins used for links, redirects, and same-origin validation.
PUBLIC_SEAFILE_URL=https://files.example.com
APP_URL=https://drive.example.com

# Required: generate with `openssl rand -hex 32`.
SESSION_SECRET=replace-with-at-least-32-random-characters

# Optional branding and administration destination.
APP_NAME=Grapple Drive
APP_ACCENT=#2563EB
ADMIN_URL=https://files.example.com/profile/
